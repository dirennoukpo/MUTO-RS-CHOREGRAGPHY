##
## MUTO-RS Robot Environment Configuration
##
## Usage:
##   cp config/.env.muto_rs.example config/.env.muto_rs
##   Edit config/.env.muto_rs with your robot-specific values
##   docker compose --env-file config/.env.muto_rs -f docker/docker-compose.muto_rs.yml up -d

## Docker Platform
# Raspberry Pi 5 uses ARM64 architecture
PLATFORM=linux/arm64

## ROS2 Configuration
ROS_DISTRO=humble
ROS_DOMAIN_ID=0
ROS_LOCALHOST_ONLY=0
RMW_IMPLEMENTATION=rmw_fastrtps_cpp
MUTO_SERIAL_PORT=/dev/ttyAMA0
MUTO_DIALOUT_GID=20

## Docker Image Configuration
PRODUCER_TAG=muto-dev
MUTO_RS_IMAGE=muto-rs-robot
IMAGE_ENV=latest

## Tailscale VPN Configuration
# Generate authkey at: https://login.tailscale.com/admin/settings/keys
TS_AUTHKEY=
TS_HOSTNAME=muto-rs-robot-01
TS_ACCEPT_ROUTES=false
TS_ADVERTISE_EXIT_NODE=false

## Robot SSH Configuration (optional)
# SSH_HOST=muto@192.168.1.161
