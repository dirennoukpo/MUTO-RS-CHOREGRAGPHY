# MUTO-RS Workstation Environment Configuration
# Usage: cp config/.env.workstation.example config/.env.workstation
#        docker compose --env-file config/.env.workstation -f docker/docker-compose.workstation.yml up -d

## Docker Platform
# Local development machine (typically amd64)
PLATFORM=linux/amd64

## ROS2 Configuration
ROS_DISTRO=humble
ROS_DOMAIN_ID=0
ROS_LOCALHOST_ONLY=0
RMW_IMPLEMENTATION=rmw_fastrtps_cpp

## Docker Image Configuration
PRODUCER_TAG=muto-dev
MUTO_WS_IMAGE=muto-workstation-dev
IMAGE_ENV=latest

## Tailscale VPN Configuration
# Generate authkey at: https://login.tailscale.com/admin/settings/keys
TS_AUTHKEY=
TS_HOSTNAME=muto-workstation-01
TS_ACCEPT_ROUTES=false
TS_ADVERTISE_EXIT_NODE=false

## Development Settings
# Mount only the src directory for live development
VOLUME_MUTO_WS_SRC=/path/to/muto_ws/src
