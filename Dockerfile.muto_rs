# =============================================================================
# Dockerfile.muto_rs — ROS2 Control + IMU only
# Architecture cible : linux/arm64
# =============================================================================

ARG ROS_DISTRO=jazzy
FROM ros:${ROS_DISTRO}-ros-base AS muto_rs

ARG DEBIAN_FRONTEND=noninteractive
ARG USER_ID=1000
ARG GROUP_ID=1000
ARG USERNAME=rosmaster

# Renommer l'utilisateur existant uid=1000 en rosmaster
# et lui donner les mêmes groupes supplémentaires que l'hôte
RUN existing_user=$(getent passwd ${USER_ID} | cut -d: -f1) && \
    if [ -n "$existing_user" ] && [ "$existing_user" != "$USERNAME" ]; then \
        usermod -l ${USERNAME} ${existing_user} && \
        groupmod -n ${USERNAME} ${existing_user} 2>/dev/null || true && \
        usermod -d /home/${USERNAME} -m ${USERNAME} 2>/dev/null || true; \
    elif ! id ${USERNAME} > /dev/null 2>&1; then \
        groupadd -g ${GROUP_ID} ${USERNAME} && \
        useradd -u ${USER_ID} -g ${GROUP_ID} -m -s /bin/bash ${USERNAME}; \
    fi && \
    # Groupes supplémentaires (miroir hôte : dialout, audio, video, sudo, etc.)
    groupadd -f dialout || true && \
    groupadd -f audio    || true && \
    groupadd -f video    || true && \
    groupadd -f plugdev  || true && \
    groupadd -f input    || true && \
    groupadd -f render   || true && \
    groupadd -f netdev   || true && \
    groupadd -f sudo     || true && \
    usermod -aG dialout,audio,video,plugdev,input,render,netdev,sudo ${USERNAME} && \
    # sudo sans mot de passe
    echo "${USERNAME} ALL=(ALL) NOPASSWD:ALL" >> /etc/sudoers

# Dépendances système minimales
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential cmake git pkg-config ninja-build \
    python3-dev python3-pip python3-colcon-common-extensions \
    python3-colcon-mixin python3-rosdep python3-vcstool python3-argcomplete \
    wget curl ca-certificates net-tools iputils-ping iproute2 \
    usbutils udev libusb-1.0-0-dev picocom python3-serial socat \
    libjpeg-dev nlohmann-json3-dev libssl-dev \
    && rm -rf /var/lib/apt/lists/*

# FastDDS
RUN apt-get update && apt-get install -y --no-install-recommends \
    ros-${ROS_DISTRO}-rmw-fastrtps-cpp \
    ros-${ROS_DISTRO}-fastrtps \
    ros-${ROS_DISTRO}-fastcdr \
    ros-${ROS_DISTRO}-rosidl-typesupport-fastrtps-cpp \
    ros-${ROS_DISTRO}-rosidl-typesupport-fastrtps-c \
    && rm -rf /var/lib/apt/lists/*

# ROS2 Core & messages
RUN apt-get update && apt-get install -y --no-install-recommends \
    ros-${ROS_DISTRO}-rclcpp \
    ros-${ROS_DISTRO}-rclcpp-components \
    ros-${ROS_DISTRO}-rclpy \
    ros-${ROS_DISTRO}-sensor-msgs \
    ros-${ROS_DISTRO}-geometry-msgs \
    ros-${ROS_DISTRO}-std-msgs \
    ros-${ROS_DISTRO}-std-srvs \
    ros-${ROS_DISTRO}-diagnostic-msgs \
    ros-${ROS_DISTRO}-builtin-interfaces \
    && rm -rf /var/lib/apt/lists/*

# ROS2 Control
RUN apt-get update && apt-get install -y --no-install-recommends \
    ros-${ROS_DISTRO}-ros2-control \
    ros-${ROS_DISTRO}-ros2-controllers \
    ros-${ROS_DISTRO}-controller-manager \
    ros-${ROS_DISTRO}-hardware-interface \
    ros-${ROS_DISTRO}-composition \
    ros-${ROS_DISTRO}-rclcpp-lifecycle \
    && rm -rf /var/lib/apt/lists/*

# IMU
RUN apt-get update && apt-get install -y --no-install-recommends \
    ros-${ROS_DISTRO}-imu-tools \
    ros-${ROS_DISTRO}-imu-filter-madgwick \
    && rm -rf /var/lib/apt/lists/*

# rosdep init + update
RUN rosdep init 2>/dev/null || true && rosdep update --rosdistro ${ROS_DISTRO}

# Fichier FastDDS minimal
RUN mkdir -p /etc/fastdds && \
    printf '<?xml version="1.0" encoding="UTF-8" ?>\n<profiles xmlns="http://www.eprosima.com/XMLSchemas/fastRTPS_Profiles">\n</profiles>\n' \
    > /etc/fastdds/fastdds_base.xml

# Workspace
RUN mkdir -p /muto_ws && chown -R ${USER_ID}:${GROUP_ID} /muto_ws

COPY muto_ws/src /muto_ws/src
WORKDIR /muto_ws

RUN bash -c "\
    source /opt/ros/${ROS_DISTRO}/setup.bash && \
    if [ \"\$(find src -name 'package.xml' | wc -l)\" -gt 0 ]; then \
        apt-get update && \
        rosdep install --from-paths src --ignore-src -r -y && \
        colcon build --cmake-args -DCMAKE_BUILD_TYPE=Release; \
    else \
        echo '[INFO] Aucun package ROS2 trouvé — build ignoré.'; \
    fi && \
    rm -rf /var/lib/apt/lists/* build log /root/.ros"

# Entrypoint
COPY entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

# Bashrc rosmaster
RUN mkdir -p /home/${USERNAME} && chown ${USER_ID}:${GROUP_ID} /home/${USERNAME} && \
    printf '%s\n' \
        "source /opt/ros/${ROS_DISTRO}/setup.bash" \
        "[ -f /muto_ws/install/setup.bash ] && source /muto_ws/install/setup.bash" \
        "export RMW_IMPLEMENTATION=rmw_fastrtps_cpp" \
        "export FASTRTPS_DEFAULT_PROFILES_FILE=/etc/fastdds/fastdds_base.xml" \
    >> /home/${USERNAME}/.bashrc

USER ${USERNAME}
ENTRYPOINT ["/entrypoint.sh"]
CMD ["bash"]