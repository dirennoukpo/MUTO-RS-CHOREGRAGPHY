<?xml version="1.0"?>
<robot xmlns:xacro="http://ros.org" name="muto_robot">

  <link name="dummy_root"/>

  <joint name="dummy_to_base_joint" type="fixed">
    <parent link="dummy_root"/>
    <child link="base_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <xacro:include filename="$(find muto_description)/urdf/Muto.urdf"/>

  <ros2_control name="MutoHardwareInterface" type="system">
    <hardware>
      <plugin>gz_ros2_control/GazeboSimSystem</plugin>
    </hardware>

    <!-- ─── RIGHT SIDE ────────────────────────────────────────── -->

    <!-- yq - Front Right -->
    <joint name="yq1_Joint">
      <command_interface name="position"><param name="min">-1.2</param><param name="max">1.2</param></command_interface>
      <state_interface name="position"/>
    </joint>
    <joint name="yq2_Joint">
      <command_interface name="position"><param name="min">-1.57</param><param name="max">1.57</param></command_interface>
      <state_interface name="position"/>
    </joint>
    <joint name="yq3_Joint">
      <command_interface name="position"><param name="min">-1.57</param><param name="max">0.7</param></command_interface>
      <state_interface name="position"/>
    </joint>

    <!-- yz - Mid Right -->
    <joint name="yz1_Joint">
      <command_interface name="position"><param name="min">-1.2</param><param name="max">1.2</param></command_interface>
      <state_interface name="position"/>
    </joint>
    <joint name="yz2_Joint">
      <command_interface name="position"><param name="min">-1.57</param><param name="max">1.57</param></command_interface>
      <state_interface name="position"/>
    </joint>
    <joint name="yz3_Joint">
      <command_interface name="position"><param name="min">-1.57</param><param name="max">0.7</param></command_interface>
      <state_interface name="position"/>
    </joint>

    <!-- yh - Rear Right -->
    <joint name="yh1_Joint">
      <command_interface name="position"><param name="min">-1.2</param><param name="max">1.2</param></command_interface>
      <state_interface name="position"/>
    </joint>
    <joint name="yh2_Joint">
      <command_interface name="position"><param name="min">-1.57</param><param name="max">1.57</param></command_interface>
      <state_interface name="position"/>
    </joint>
    <joint name="yh3_Joint">
      <command_interface name="position"><param name="min">-1.57</param><param name="max">0.7</param></command_interface>
      <state_interface name="position"/>
    </joint>

    <!-- ─── LEFT SIDE ─────────────────────────────────────────── -->

    <!-- zq - Front Left -->
    <joint name="zq1_Joint">
      <command_interface name="position"><param name="min">-1.2</param><param name="max">1.2</param></command_interface>
      <state_interface name="position"/>
    </joint>
    <joint name="zq2_Joint">
      <command_interface name="position"><param name="min">-1.57</param><param name="max">1.57</param></command_interface>
      <state_interface name="position"/>
    </joint>
    <joint name="zq3_Joint">
      <command_interface name="position"><param name="min">-1.57</param><param name="max">0.7</param></command_interface>
      <state_interface name="position"/>
    </joint>

    <!-- zz - Mid Left -->
    <joint name="zz1_Joint">
      <command_interface name="position"><param name="min">-1.2</param><param name="max">1.2</param></command_interface>
      <state_interface name="position"/>
    </joint>
    <joint name="zz2_Joint">
      <command_interface name="position"><param name="min">-1.57</param><param name="max">1.57</param></command_interface>
      <state_interface name="position"/>
    </joint>
    <joint name="zz3_Joint">
      <command_interface name="position"><param name="min">-1.57</param><param name="max">0.7</param></command_interface>
      <state_interface name="position"/>
    </joint>

    <!-- zh - Rear Left -->
    <joint name="zh1_Joint">
      <command_interface name="position"><param name="min">-1.2</param><param name="max">1.2</param></command_interface>
      <state_interface name="position"/>
    </joint>
    <joint name="zh2_Joint">
      <command_interface name="position"><param name="min">-1.57</param><param name="max">1.57</param></command_interface>
      <state_interface name="position"/>
    </joint>
    <joint name="zh3_Joint">
      <command_interface name="position"><param name="min">-1.57</param><param name="max">0.7</param></command_interface>
      <state_interface name="position"/>
    </joint>

  </ros2_control>

  <!-- Plugin required to connect ros2_control to Gazebo -->
  <gazebo>
    <plugin filename="libgz_ros2_control-system.so" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
      <parameters>$(find muto_description)/config/controllers.yaml</parameters>
    </plugin>
  </gazebo>

  <!-- IMU sensor aligned on dummy_root -->
  <gazebo reference="dummy_root">
    <sensor name="muto_gazebo_imu" type="imu">
      <always_on>1</always_on>
      <update_rate>20</update_rate>
      <visualize>true</visualize>
      <topic>gazebo/imu</topic>
    </sensor>
  </gazebo>

</robot>