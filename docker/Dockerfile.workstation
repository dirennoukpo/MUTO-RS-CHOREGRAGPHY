# docker/Dockerfile.workstation
# Development image for MUTO-RS Workstation
# Includes ROS2 Humble, dev tools, simulation (RViz2, Nav2), and audio/ML libraries

FROM ros:humble-ros-base-jammy

ARG ROS_DISTRO=humble
ARG PRODUCER_TAG=muto-dev
ARG BUILD_DATE
ARG GIT_COMMIT

LABEL maintainer="MUTO-RS Contributors"
LABEL description="MUTO-RS Workstation Dev Image"
LABEL ros.distro="${ROS_DISTRO}"

ENV DEBIAN_FRONTEND=noninteractive
ENV ROS_DISTRO=${ROS_DISTRO}

# ─────────────────────────────────────────────────────────────
# STEP 1: System & Development Dependencies
# ─────────────────────────────────────────────────────────────

RUN apt-get update && apt-get install -y --no-install-recommends \
    bash-completion \
    build-essential \
    cmake \
    git \
    curl \
    wget \
    nano \
    vim \
    unzip \
    gdb \
    && rm -rf /var/lib/apt/lists/*

# ─────────────────────────────────────────────────────────────
# STEP 2: Audio & Media Processing
# ─────────────────────────────────────────────────────────────

RUN apt-get update && apt-get install -y --no-install-recommends \
    ffmpeg \
    libfftw3-dev \
    libavcodec-dev \
    libavformat-dev \
    libavutil-dev \
    libswresample-dev \
    libsamplerate0-dev \
    libsndfile1-dev \
    libblas-dev \
    liblapack-dev \
    gfortran \
    && rm -rf /var/lib/apt/lists/*

# ─────────────────────────────────────────────────────────────
# STEP 3: Python Development & Data Science
# ─────────────────────────────────────────────────────────────

RUN apt-get update && apt-get install -y --no-install-recommends \
    python3-dev \
    python3-pip \
    python3-setuptools \
    python3-wheel \
    python3-colcon-common-extensions \
    python3-rosdep \
    python3-vcstool \
    && rm -rf /var/lib/apt/lists/*

# Upgrade pip
RUN pip install --upgrade pip setuptools wheel

# Audio and ML libraries
RUN pip install --no-cache-dir \
    cython \
    numpy \
    scipy \
    librosa \
    soundfile \
    numba \
    scikit-learn \
    aubio \
    essentia

# madmom for beat tracking
RUN pip install --no-cache-dir --no-build-isolation \
    git+https://github.com/CPJKU/madmom.git

# ─────────────────────────────────────────────────────────────
# STEP 4: ROS2 Simulation & Navigation Tools
# ─────────────────────────────────────────────────────────────

RUN apt-get update && apt-get install -y --no-install-recommends \
    ros-${ROS_DISTRO}-rviz2 \
    ros-${ROS_DISTRO}-navigation2 \
    ros-${ROS_DISTRO}-nav2-bringup \
    ros-${ROS_DISTRO}-behaviortree-cpp-v3 \
    ros-${ROS_DISTRO}-rmw-fastrtps-cpp \
    && rm -rf /var/lib/apt/lists/*

# ─────────────────────────────────────────────────────────────
# STEP 5: Create non-root user 'muto'
# ─────────────────────────────────────────────────────────────

ARG USERNAME=muto
ARG GROUPNAME=muto
ARG USER_UID=1000
ARG USER_GID=1000

RUN groupadd --gid ${USER_GID} ${GROUPNAME} \
    && useradd --uid ${USER_UID} --gid ${USER_GID} -m -s /bin/bash ${USERNAME} \
    && echo "${USERNAME} ALL=(ALL) NOPASSWD:ALL" > /etc/sudoers.d/${USERNAME} \
    && chmod 0440 /etc/sudoers.d/${USERNAME}

# Create .ros directory for user
RUN mkdir -p /home/${USERNAME}/.ros \
    && chown -R ${USERNAME}:${GROUPNAME} /home/${USERNAME}

# ─────────────────────────────────────────────────────────────
# STEP 6: Prepare workspace
# ─────────────────────────────────────────────────────────────

WORKDIR /muto_ws

# Copy workspace source (with correct ownership)
COPY --chown=muto:muto muto_ws /muto_ws

# ─────────────────────────────────────────────────────────────
# STEP 7: Install ROS2 dependencies via rosdep
# ─────────────────────────────────────────────────────────────

RUN apt-get update \
    && rosdep install --from-paths src --ignore-src -r -y \
    && rm -rf /var/lib/apt/lists/*

# ─────────────────────────────────────────────────────────────
# STEP 8: Build workspace with colcon
# ─────────────────────────────────────────────────────────────

RUN rm -rf build install log && \
    . /opt/ros/${ROS_DISTRO}/setup.sh && \
    colcon build --cmake-args -DCMAKE_BUILD_TYPE=Release

# Verify build succeeded
RUN test -f /muto_ws/install/setup.bash || \
    (echo "❌ ERROR: Workspace build failed"; exit 1)

# ─────────────────────────────────────────────────────────────
# STEP 9: Setup user environment in bashrc
# ─────────────────────────────────────────────────────────────

RUN chown -R muto:muto /muto_ws

USER muto
RUN echo "source /opt/ros/${ROS_DISTRO}/setup.bash" >> ~/.bashrc && \
    echo "source /muto_ws/install/setup.bash" >> ~/.bashrc && \
    echo "export ROS_DOMAIN_ID=${ROS_DOMAIN_ID:-0}" >> ~/.bashrc && \
    echo "export PYTHONPATH=/muto_ws/install/lib/python3.*/site-packages:\$PYTHONPATH" >> ~/.bashrc

USER root

# ─────────────────────────────────────────────────────────────
# STEP 10: Copy entrypoint
# ─────────────────────────────────────────────────────────────

COPY docker/entrypoint.workstation.sh /entrypoint.workstation.sh
RUN chmod +x /entrypoint.workstation.sh

# ─────────────────────────────────────────────────────────────
# FINAL: Set user & entrypoint
# ─────────────────────────────────────────────────────────────

USER muto
WORKDIR /muto_ws

ENTRYPOINT ["/entrypoint.workstation.sh"]
CMD ["bash"]